generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Alcance de `Role`:
///  - USER / DISTRICT_SECRETARY / DISTRICT_RDR / COMPANY: se persisten en User.role.
///  - PRESIDENT: valor VIRTUAL — se calcula al login desde Membership.isPresident.
///    Un CHECK constraint en User.role (ver migración 20260417100000) impide
///    que se persista. Sólo vive en el claim del JWT.
enum Role {
  PARTICIPANT        @map("USER")
  SECRETARY          @map("DISTRICT_SECRETARY")
  PRESIDENT
  RDR                @map("DISTRICT_RDR")
  COMPANY
  SUPERADMIN

  @@map("Role")
}

enum ClubRole {
  MEMBER
  TREASURER
  SECRETARY
  VICE_PRESIDENT
  PRESIDENT
  PRESIDENT_ELECT
  PAST_PRESIDENT
  CUSTOM
}

enum ClubPresidencyStatus {
  ELECTED
  ACTIVE
  ENDED
  REVOKED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  ACCEPTED_BY_DESTINATION
  CONFIRMED_BY_ORIGIN
  COMPLETED
  REJECTED
  CANCELLED
}

enum CartaPoderStatus {
  DRAFT
  PENDING_SECRETARY
  SUBMITTED
  VERIFIED
  REJECTED
}

enum ClubStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  LICENCIA
  EGRESADO
  PENDIENTE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  OBSERVED
  APPROVED
  REJECTED
}

enum ReportType {
  MENSUAL
  TRIMESTRAL
  ANUAL
}

enum CommitteeStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum MeetingType {
  ORDINARY
  EXTRAORDINARY
}

enum ActaStatus {
  DRAFT
  PUBLISHED
}

enum VotingMethod {
  PUBLIC
  SECRET
}

enum MajorityType {
  SIMPLE
  ABSOLUTE
  TWO_THIRDS
  THREE_QUARTERS
}

enum BallotType {
  YES_NO
  CANDIDATE
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  FINISHED
  ARCHIVED
}

enum AttendanceStatus {
  INVITED
  JOINED
  LEFT
}

enum TopicType {
  DISCUSSION
  VOTING
  INFORMATIVE
}

enum TopicStatus {
  PENDING
  ACTIVE
  DONE
}

model User {
  id                    String              @id @default(cuid())
  fullName              String
  email                 String              @unique
  passwordHash          String
  role                  Role
  isActive              Boolean             @default(true)
  mustChangePassword    Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  memberships           Membership[]
  createdMeetings       Meeting[]           @relation("MeetingCreator")
  meetingParticipants   MeetingParticipant[]
  speakingRequests      SpeakingRequest[]
  reportsReviewed       Report[]
  committeesCoordinated Committee[]         @relation("CommitteeCoordinator")
  committeeMemberships  CommitteeMember[]
  organizedEvents       Event[]             @relation("EventOrganizer")
  grantedEventPermissions EventDistrictPermission[] @relation("EventPermissionGrantedBy")
  revokedEventPermissions EventDistrictPermission[] @relation("EventPermissionRevokedBy")
  eventRegistrations    EventRegistration[] @relation("EventRegistrationUser")
  eventCheckIns         EventRegistration[] @relation("EventRegistrationCheckedInBy")
  scannedCheckInLogs    EventCheckInLog[]   @relation("CheckInLogScanner")
  receivedPayments      EventPayment[]      @relation("PaymentReceivedBy")
  scannedMealConsumptions EventMealConsumption[] @relation("MealScannedBy")
  notifications         Notification[]
  attachments           Attachment[]
  assignedProjects      Project[]           @relation("ProjectAssignee")
  profile               UserProfile?
  createdOpportunities  Opportunity[]
  memberProfiles        Member[]
  passwordResetTokens   PasswordResetToken[]
  company               Company?
  talentContactRequests TalentContactRequest[]
  electedPresidencies   ClubPresidency[]     @relation("ClubPresidencyElectedBy")
  membershipApplications MembershipApplication[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

enum OpportunityType {
  EMPLEO
  PASANTIA
  BECA
  VOLUNTARIADO
  CAPACITACION
  LIDERAZGO
  CONVOCATORIA
}

enum OpportunityModality {
  PRESENCIAL
  VIRTUAL
  HIBRIDA
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Opportunity {
  id           String              @id @default(cuid())
  title        String
  description  String?             @db.Text
  requirements String?             @db.Text
  type         OpportunityType
  modality     OpportunityModality
  area         String?
  organization String?
  externalUrl  String?
  deadlineAt   DateTime?
  status       OpportunityStatus   @default(DRAFT)
  featured     Boolean             @default(false)
  createdById  String
  publishedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  creator      User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  @@index([status, deadlineAt])
  @@index([type])
  @@index([organization])
}

model UserProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  photoUrl           String?
  profession         String?
  bio                String?  @db.Text
  city               String?
  linkedInUrl        String?
  skills             String[] @default([])
  interests          String[] @default([])
  experienceJson     String?
  educationJson      String?
  languagesJson      String?
  availability       String?
  contactEmailPublic Boolean  @default(false)
  talentVisible      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([talentVisible])
}

model Club {
  id                       String     @id @default(cuid())
  name                     String
  code                     String     @unique
  status                   ClubStatus @default(ACTIVE)
  presidentEmail           String?
  isConstituido            Boolean    @default(true)
  enabledForDistrictMeetings Boolean  @default(true)
  cuotaAldia               Boolean    @default(false)
  informeAlDia             Boolean    @default(false)
  logoUrl                  String?
  city                     String?
  zone                     String?
  foundedAt                DateTime?
  description              String?
  contactEmail             String?
  contactPhone             String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  presidencyExtended       Boolean    @default(false)
  memberships              Membership[]
  members                  Member[]
  meetings                 Meeting[]
  reports                  Report[]
  events                   Event[]
  projects                 Project[]
  auditLogs                AuditLog[]
  meetingAttendances       ClubMeetingAttendance[]
  cartasPoder              CartaPoder[]
  eventPermissions         EventDistrictPermission[]
  presidencies             ClubPresidency[]
  boardPositions           ClubBoardPosition[]
  membershipApplications   MembershipApplication[]
  transfersFrom            MemberTransferRequest[] @relation("TransferFromClub")
  transfersTo              MemberTransferRequest[] @relation("TransferToClub")
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  clubId     String
  title      String?
  clubRole   ClubRole @default(MEMBER)
  isPresident Boolean @default(false)
  activeFrom DateTime @default(now())
  activeUntil DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([userId, clubId])
  @@index([userId])
  @@index([clubId])
  @@index([clubId, clubRole])
}

model Member {
  id            String       @id @default(cuid())
  clubId        String
  userId        String?
  firstName     String
  lastName      String
  email         String
  phone         String?
  birthDate     DateTime?
  joinedAt      DateTime?
  status        MemberStatus @default(PENDIENTE)
  title         String?
  isPresident   Boolean      @default(false)
  internalNotes String?      @db.Text
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  club          Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  presidencies  ClubPresidency[]
  boardPositions ClubBoardPosition[]
  transferRequests MemberTransferRequest[]

  @@unique([clubId, email])
  @@unique([clubId, userId])
  @@index([clubId, status])
  @@index([clubId, deletedAt])
  @@index([clubId, title])
}

model Meeting {
  id                 String        @id @default(cuid())
  title              String
  description        String?
  scheduledAt        DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  status             MeetingStatus @default(DRAFT)
  type               MeetingType   @default(ORDINARY)
  isDistrictMeeting  Boolean       @default(true)
  quorumRequired     Int?
  quorumMet          Boolean       @default(false)
  isInformationalOnly Boolean      @default(false)
  attendanceLocked   Boolean       @default(false)
  attendanceLockedAt DateTime?
  currentTopicId     String?
  createdById        String
  clubId             String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  creator            User          @relation("MeetingCreator", fields: [createdById], references: [id])
  club               Club          @relation(fields: [clubId], references: [id])
  participants       MeetingParticipant[]
  topics             AgendaTopic[]
  voteSessions       VoteSession[]
  speakingRequests   SpeakingRequest[]
  currentSpeakerId   String?
  nextSpeakerId      String?
  timerSessions      TimerSession[]
  auditLogs          AuditLog[]
  clubAttendances    ClubMeetingAttendance[]
  cartasPoder        CartaPoder[]
  acta               MeetingActa?
  @@index([clubId])
  @@index([status, scheduledAt])
  @@index([type])
}

model AgendaTopic {
  id                  String      @id @default(cuid())
  meetingId           String
  title               String
  description         String?
  order               Int         @default(0)
  type                TopicType   @default(DISCUSSION)
  estimatedDurationSec Int?
  status              TopicStatus @default(PENDING)
  meeting             Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  voteSessions        VoteSession[]
  @@index([meetingId, order])
}

enum VoteSessionStatus {
  OPEN
  CLOSED
}

enum VoteChoice {
  YES
  NO
  ABSTAIN
}

model VoteSession {
  id                       String            @id @default(cuid())
  meetingId                String
  topicId                  String
  status                   VoteSessionStatus @default(OPEN)
  votingMethod             VotingMethod      @default(PUBLIC)
  requiredMajority         MajorityType      @default(SIMPLE)
  isElection               Boolean           @default(false)
  ballotType               BallotType        @default(YES_NO)
  round                    Int               @default(1)
  previousSessionId        String?
  rdrTiebreakerUsed        Boolean           @default(false)
  rdrTiebreakerChoice      VoteChoice?
  rdrTiebreakerCandidateId String?
  eligibleClubIds          String?           @db.Text
  eligibleClubCount        Int?
  openedAt                 DateTime          @default(now())
  closedAt                 DateTime?
  openedById               String?
  closedById               String?
  votes                    Vote[]
  sealedVotes              SealedVote[]
  candidates               VoteCandidate[]
  previousSession          VoteSession?      @relation("VoteRound", fields: [previousSessionId], references: [id])
  nextRounds               VoteSession[]     @relation("VoteRound")
  topic                    AgendaTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  meeting                  Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  @@index([meetingId, status])
  @@index([previousSessionId])
}

model VoteCandidate {
  id            String      @id @default(cuid())
  voteSessionId String
  displayName   String
  userId        String?
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  session       VoteSession @relation(fields: [voteSessionId], references: [id], onDelete: Cascade)
  votes         Vote[]
  @@index([voteSessionId])
}

model Vote {
  id           String    @id @default(cuid())
  voteSessionId String
  userId      String
  clubId      String?
  choice      VoteChoice
  candidateId String?
  createdAt   DateTime  @default(now())
  session     VoteSession    @relation(fields: [voteSessionId], references: [id], onDelete: Cascade)
  candidate   VoteCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  @@unique([voteSessionId, userId])
  @@index([voteSessionId])
  @@index([voteSessionId, clubId])
  @@index([candidateId])
}

model MeetingParticipant {
  id                String           @id @default(cuid())
  meetingId         String
  userId            String
  clubId            String?
  canVote           Boolean          @default(true)
  isDelegate        Boolean          @default(false)
  attendanceStatus  AttendanceStatus @default(INVITED)
  joinedAt          DateTime?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting           Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
  @@index([meetingId, clubId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum EventType {
  DISTRITAL
  CLUB
  CAPACITACION
  REUNION
  ASAMBLEA
  PROYECTO_SERVICIO
  NETWORKING
  PROFESIONAL
  CONFERENCIA
  ERIPA
  FORO_ZONAL
  SEMINARIO_INSTRUCTORES
}

enum EventModality {
  PRESENCIAL
  VIRTUAL
  HIBRIDA
}

enum SpeakingRequestStatus {
  PENDING
  ACCEPTED
  CANCELLED
  DONE
}

model SpeakingRequest {
  id          String                @id @default(cuid())
  meetingId   String
  userId      String
  status      SpeakingRequestStatus @default(PENDING)
  position    Int                   @default(0)
  requestedAt DateTime             @default(now())
  acceptedAt  DateTime?
  meeting     Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([meetingId, status])
}

model TimerSession {
  id                String    @id @default(cuid())
  meetingId         String
  topicId           String?
  speakingRequestId String?
  type              String    // TOPIC | SPEAKER
  plannedDurationSec Int
  startedAt         DateTime  @default(now())
  pausedAt          DateTime?
  endedAt           DateTime?
  overtimeSec       Int       @default(0)
  meeting           Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  @@index([meetingId])
}

model AuditLog {
  id           String   @id @default(cuid())
  meetingId    String?
  clubId       String?
  actorUserId  String?
  action       String
  entityType   String?
  entityId     String?
  metadataJson String?
  createdAt    DateTime @default(now())
  meeting      Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  @@index([meetingId, createdAt])
  @@index([clubId, createdAt])
}

model CartaPoder {
  id                 String           @id @default(cuid())
  meetingId          String
  clubId             String
  presidentUserId    String
  delegateUserId     String
  delegateDocNumber  String?
  delegateDocType    String?          // 'DNI' | 'PASAPORTE' | 'CI'
  status             CartaPoderStatus @default(DRAFT)
  secretaryUserId    String?
  secretarySignedAt  DateTime?
  submittedAt        DateTime?
  rejectionReason    String?
  receivedAt         DateTime         @default(now())
  verified           Boolean          @default(false)
  verifiedById       String?
  documentUrl        String?
  meeting            Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  club               Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([meetingId, clubId])
  @@index([meetingId])
  @@index([clubId, status])
}

model ClubMeetingAttendance {
  id             String   @id @default(cuid())
  meetingId      String
  clubId         String
  attendeeUserId String
  isDelegate     Boolean  @default(false)
  cartaPoderId   String?
  createdAt      DateTime @default(now())
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([meetingId, clubId])
  @@index([clubId])
}

model SealedVote {
  id            String     @id @default(cuid())
  voteSessionId String
  clubId        String
  choice        VoteChoice
  priorityOrder Int?
  documentUrl   String?
  receivedAt    DateTime   @default(now())
  receivedById  String?
  session       VoteSession @relation(fields: [voteSessionId], references: [id], onDelete: Cascade)
  @@unique([voteSessionId, clubId])
  @@index([voteSessionId])
}

model MeetingActa {
  id            String     @id @default(cuid())
  meetingId     String     @unique
  status        ActaStatus @default(DRAFT)
  contentJson   String     @db.Text
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  meeting       Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model HealthCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())
}

model DistrictPeriod {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reports   Report[]
  committees Committee[]
  presidencies ClubPresidency[]
  boardPositions ClubBoardPosition[]
  @@index([startDate, endDate])
}

model ClubPresidency {
  id          String               @id @default(cuid())
  clubId      String
  memberId    String
  periodId    String
  status      ClubPresidencyStatus @default(ELECTED)
  startDate   DateTime?
  endDate     DateTime?
  electedById String?
  electedAt   DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  club        Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member      Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  period      DistrictPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  electedBy   User?                @relation("ClubPresidencyElectedBy", fields: [electedById], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([clubId, periodId])
  @@index([memberId])
  @@index([periodId])
}

model ClubBoardPosition {
  id        String    @id @default(cuid())
  clubId    String
  memberId  String
  role      ClubRole
  periodId  String
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  club      Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  period    DistrictPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([clubId, periodId, role])
  @@index([clubId, periodId])
  @@index([memberId])
}

model Report {
  id                     String       @id @default(cuid())
  clubId                 String
  districtPeriodId       String
  type                   ReportType
  status                 ReportStatus  @default(DRAFT)
  contentJson            String?      // contenido libre o estructurado
  observations           String?      // observaciones del distrito
  responseToObservations String?      // respuesta del club cuando OBSERVED/REJECTED
  submittedAt            DateTime?
  resubmittedAt          DateTime?    // cuándo se reenvió tras corrección
  reviewedAt             DateTime?
  reviewedById           String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  club                   Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  districtPeriod         DistrictPeriod @relation(fields: [districtPeriodId], references: [id], onDelete: Cascade)
  reviewer               User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  @@unique([clubId, districtPeriodId, type])
  @@index([clubId])
  @@index([districtPeriodId])
  @@index([status])
}

model Committee {
  id                String          @id @default(cuid())
  name              String
  description       String?
  coordinatorId     String
  status            CommitteeStatus @default(ACTIVE)
  districtPeriodId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  coordinator       User            @relation("CommitteeCoordinator", fields: [coordinatorId], references: [id], onDelete: Cascade)
  districtPeriod    DistrictPeriod? @relation(fields: [districtPeriodId], references: [id], onDelete: SetNull)
  members           CommitteeMember[]
  objectives        CommitteeObjective[]
  activities        CommitteeActivity[]
  @@index([status])
  @@index([coordinatorId])
}

model CommitteeMember {
  id          String   @id @default(cuid())
  committeeId String
  userId      String
  role        String?  // opcional: ej. "integrante", "secretario"
  joinedAt    DateTime @default(now())
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([committeeId, userId])
  @@index([committeeId])
  @@index([userId])
}

model CommitteeObjective {
  id          String   @id @default(cuid())
  committeeId String
  title       String
  description String?
  order       Int      @default(0)
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  @@index([committeeId, order])
}

model CommitteeActivity {
  id          String   @id @default(cuid())
  committeeId String
  title       String
  date       DateTime
  notes       String?
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  @@index([committeeId])
}

model Event {
  id              String         @id @default(cuid())
  title           String
  description     String?
  type            EventType
  modality        EventModality
  startsAt        DateTime
  endsAt          DateTime?
  location        String?
  meetingUrl      String?
  maxCapacity     Int?
  status          EventStatus    @default(DRAFT)
  featured        Boolean        @default(false)
  imageUrl        String?
  slug            String?        @unique
  isPaid          Boolean        @default(false)
  paymentOpensAt  DateTime?
  paymentClosesAt DateTime?
  remindersAt          DateTime[]     @default([])
  sentReminders        DateTime[]     @default([])
  changesClosesAt      DateTime?
  cancellationClosesAt DateTime?
  clubId          String?
  organizerId     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  club            Club?          @relation(fields: [clubId], references: [id], onDelete: SetNull)
  organizer       User           @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  registrations   EventRegistration[]
  ticket          EventTicket?
  installments    EventInstallment[]
  meals           EventMeal[]
  registrationForm EventRegistrationForm?
  emailTemplates  EventEmailTemplate[]
  emailLogs       EventEmailLog[]
  checkInLogs     EventCheckInLog[]

  @@index([status, startsAt])
  @@index([clubId])
  @@index([organizerId])
  @@index([featured, status, startsAt])
}

enum EventPermissionScope {
  DISTRITAL_EVENT_CREATE
  FINANCIAL_MANAGE
}

enum EventPermissionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model EventDistrictPermission {
  id          String                 @id @default(cuid())
  clubId      String
  scope       EventPermissionScope
  status      EventPermissionStatus  @default(ACTIVE)
  grantedById String
  grantedAt   DateTime               @default(now())
  expiresAt   DateTime?
  revokedById String?
  revokedAt   DateTime?
  notes       String?

  club        Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  grantedBy   User @relation("EventPermissionGrantedBy", fields: [grantedById], references: [id])
  revokedBy   User? @relation("EventPermissionRevokedBy", fields: [revokedById], references: [id])

  @@index([clubId, status])
  @@index([status, expiresAt])
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  PENDING_PAYMENT
  CANCELLED
  NO_SHOW
}

model EventRegistration {
  id               String              @id @default(cuid())
  eventId          String
  userId           String?
  email            String
  fullName         String
  phone            String?
  status           RegistrationStatus  @default(CONFIRMED)
  waitlistPosition Int?
  checkInToken     String?             @unique
  checkedInAt      DateTime?
  checkedInById    String?
  cancelledAt      DateTime?
  additionalData   String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  event            Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User? @relation("EventRegistrationUser", fields: [userId], references: [id], onDelete: SetNull)
  checkedInBy      User? @relation("EventRegistrationCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  payments         EventPayment[]
  mealConsumptions EventMealConsumption[]
  emailLogs        EventEmailLog[]
  checkInLogs      EventCheckInLog[]

  @@unique([eventId, email])
  @@index([eventId, status])
  @@index([userId])
}

enum CheckInResult {
  CHECKED_IN
  ALREADY_CHECKED_IN
  INVALID_TOKEN
  WRONG_EVENT
  REGISTRATION_CANCELLED
  PAYMENT_PENDING
  EVENT_NOT_OPEN
  FORBIDDEN
}

model EventCheckInLog {
  id             String        @id @default(cuid())
  eventId        String
  registrationId String?
  token          String
  result         CheckInResult
  scannedById    String
  deviceInfo     String?
  scannedAt      DateTime      @default(now())

  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  scannedBy      User               @relation("CheckInLogScanner", fields: [scannedById], references: [id])

  @@index([eventId, scannedAt])
  @@index([registrationId])
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  TRANSFER
  CASH
  CARD
  MERCADO_PAGO
  OTHER
}

model EventTicket {
  id        String   @id @default(cuid())
  eventId   String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("ARS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventInstallment {
  id       String   @id @default(cuid())
  eventId  String
  order    Int
  label    String
  amount   Decimal  @db.Decimal(12, 2)
  dueDate  DateTime
  payments EventPayment[]

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, order])
  @@index([eventId])
}

model EventPayment {
  id              String             @id @default(cuid())
  registrationId  String
  installmentId   String
  amount          Decimal            @db.Decimal(12, 2)
  status          PaymentStatus      @default(PENDING)
  method          PaymentMethod?
  paidAt          DateTime?
  receivedById    String?
  receiptNote     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  registration    EventRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  installment     EventInstallment   @relation(fields: [installmentId], references: [id])
  receivedBy      User?              @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  @@unique([registrationId, installmentId])
  @@index([registrationId, status])
}

model EventMeal {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  servedAt    DateTime
  windowStart DateTime
  windowEnd   DateTime
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consumptions EventMealConsumption[]

  @@index([eventId, order])
}

enum MealScanResult {
  CONSUMED
  ALREADY_CONSUMED
  OUTSIDE_WINDOW
  REGISTRATION_NOT_CONFIRMED
  WRONG_EVENT
  INVALID_TOKEN
  MEAL_NOT_FOUND
}

model EventRegistrationForm {
  id        String   @id @default(cuid())
  eventId   String   @unique
  schema    Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventMealConsumption {
  id             String            @id @default(cuid())
  mealId         String
  registrationId String
  consumedAt     DateTime          @default(now())
  scannedById    String
  deviceInfo     String?

  meal           EventMeal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  scannedBy      User              @relation("MealScannedBy", fields: [scannedById], references: [id])

  @@unique([mealId, registrationId])
  @@index([mealId, consumedAt])
}

enum EmailTemplateType {
  REGISTRATION_CONFIRMATION
  REMINDER
  EVENT_CANCELLED
  PAYMENT_WINDOW_OPEN
  PAYMENT_WINDOW_CLOSING
  WAITLIST_PROMOTED
  PAYMENT_RECORDED
  INSTALLMENT_DUE_REMINDER
  PAYMENT_COMPLETE
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

model EventEmailTemplate {
  id        String            @id @default(cuid())
  eventId   String
  type      EmailTemplateType
  subject   String
  bodyHtml  String            @db.Text
  bodyText  String?           @db.Text
  updatedAt DateTime          @updatedAt
  createdAt DateTime          @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, type])
}

model EventEmailLog {
  id                String            @id @default(cuid())
  eventId           String
  registrationId    String?
  toEmail           String
  templateType      EmailTemplateType
  status            EmailStatus       @default(QUEUED)
  providerMessageId String?
  sentAt            DateTime?
  error             String?
  createdAt         DateTime          @default(now())

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration      EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([eventId, templateType])
  @@index([status])
  @@index([registrationId])
}

enum ProjectStatus {
  IDEA
  PLANIFICACION
  EN_EJECUCION
  FINALIZADO
  CANCELADO
}

enum ProjectCategory {
  SOCIAL
  PROFESIONAL
  AMBIENTAL
  OTRO
}

model Project {
  id           String          @id @default(cuid())
  clubId       String
  title        String
  description  String?
  status       ProjectStatus   @default(IDEA)
  category     ProjectCategory?
  startDate    DateTime?
  endDate      DateTime?
  assignedToId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  club         Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  assignedTo   User?           @relation("ProjectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  progress     ProjectProgress[]
  @@index([clubId])
  @@index([clubId, status])
}

model ProjectProgress {
  id           String   @id @default(cuid())
  projectId    String
  description  String
  progressDate DateTime
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model Attachment {
  id             String   @id @default(cuid())
  entityType     String   // "report" | "project" | "event" | "committee_activity" | "meeting"
  entityId       String
  fileName       String
  mimeType       String?
  sizeBytes      Int?
  storageKey     String
  storageBackend String   @default("r2") // "r2" | "fs" (para migración)
  uploadedById   String
  uploadedAt     DateTime @default(now())
  user           User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  @@index([entityType, entityId])
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Company {
  id           String        @id @default(cuid())
  name         String
  country      String?
  city         String?
  industry     String?
  size         String?
  website      String?
  contactName  String
  contactEmail String
  phone        String?
  status       CompanyStatus @default(PENDING)
  ownerUserId  String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  owner        User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  contactRequests TalentContactRequest[]

  @@index([status])
}

enum TalentContactRequestStatus {
  NEW
  SHARED_WITH_MEMBER
  CLOSED
}

model TalentContactRequest {
  id              String                     @id @default(cuid())
  companyId       String
  talentUserId    String
  message         String?
  status          TalentContactRequestStatus @default(NEW)
  createdAt       DateTime                   @default(now())
  handledAt       DateTime?
  handledByUserId String?

  company         Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  talentUser      User                       @relation(fields: [talentUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([talentUserId])
  @@index([status, createdAt])
}

enum NotificationType {
  REGISTRATION_CREATED
  REGISTRATION_CANCELLED
  PAYMENT_RECORDED
  CHECKIN_PERFORMED
  EVENT_CANCELLED
  EVENT_REMINDER
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  INSTALLMENT_DUE
  WAITLIST_PROMOTED

  // Carta Poder (Art. 46)
  CARTA_PODER_PENDING_SECRETARY
  CARTA_PODER_SUBMITTED
  CARTA_PODER_VERIFIED
  CARTA_PODER_REJECTED

  // Sucesión de presidencia
  PRESIDENCY_DESIGNATED
  PRESIDENCY_REMINDER
  PRESIDENCY_NO_SUCCESSOR
  PRESIDENCY_TRANSITION
  PRESIDENCY_REVOKED

  // Fase 4 — solicitudes de ingreso y transferencias
  MEMBERSHIP_APPLICATION_RECEIVED
  MEMBERSHIP_APPLICATION_APPROVED
  MEMBERSHIP_APPLICATION_REJECTED
  TRANSFER_REQUESTED
  TRANSFER_ACCEPTED
  TRANSFER_COMPLETED
  TRANSFER_REJECTED

  // Desempate RDR (Art. 49) + elecciones multi-candidato (Art. 61-66)
  VOTE_TIE_DETECTED
  VOTE_TIEBREAKER_APPLIED

  // Panel SuperAdmin
  ADMIN_ASSIGNED_TO_CLUB
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  /** Payload opcional con keys como eventId, registrationId, amount… (JSON string). */
  data      String?          @db.Text
  eventId   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model MembershipApplication {
  id           String            @id @default(cuid())
  clubId       String
  userId       String
  firstName    String
  lastName     String
  email        String
  phone        String?
  message      String?           @db.Text
  status       ApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  memberId     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  club         Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId, status])
  @@index([clubId, createdAt])
  @@index([userId, status])
}

model MemberTransferRequest {
  id           String         @id @default(cuid())
  memberId     String
  fromClubId   String
  toClubId     String
  status       TransferStatus @default(REQUESTED)
  reason       String?        @db.Text
  requestedAt  DateTime       @default(now())
  acceptedById String?
  acceptedAt   DateTime?
  confirmedById String?
  confirmedAt  DateTime?
  completedAt  DateTime?
  rejectedById String?
  rejectedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fromClub     Club           @relation("TransferFromClub", fields: [fromClubId], references: [id], onDelete: Cascade)
  toClub       Club           @relation("TransferToClub", fields: [toClubId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([fromClubId, status])
  @@index([toClubId, status])
}
